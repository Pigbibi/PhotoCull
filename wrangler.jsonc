{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photocull",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_GITHUB_LOGINS": "YOUR_GITHUB_USERNAME",
    "APP_ORIGIN": "https://photocull.your-subdomain.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photocull",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PREVIEWS",
      "bucket_name": "photocull-previews"
    }
  ],
  "observability": { "enabled": false }
  // 通过 `wrangler secret put` 配置以下机密变量:
  // - GITHUB_CLIENT_ID
  // - GITHUB_CLIENT_SECRET
  // - SESSION_SECRET
  // - PROCESSOR_TOKEN
}
