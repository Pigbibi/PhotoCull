# PhotoCull Ubuntu Server Processor Configuration

# Microsoft OneDrive (Entra App + OAuth2 Refresh Token)
MS_CLIENT_ID=your-microsoft-client-id
MS_CLIENT_SECRET=
MS_TENANT=consumers
MS_REFRESH_TOKEN=your-microsoft-refresh-token
ONEDRIVE_SOURCE_DIRS=/Pictures/Camera Roll,/Pictures/小米相册
ONEDRIVE_TRASH_MODE=recycle_bin
ONEDRIVE_STAGING_DIR=/_PhotoCull_Trash

# Google Photos (photoslibrary.appendonly scope)
GPHOTOS_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Multimodal AI Provider (gemini | openai)
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=

# Cloudflare Worker Review Console
WORKER_BASE_URL=https://photocull.your-subdomain.workers.dev
PROCESSOR_TOKEN=replace-with-shared-secret-token

# Clustering & Local State
BURST_WINDOW_SECONDS=90
DHASH_MAX_DISTANCE=12
INCLUDE_SINGLETONS=true
LOCAL_STATE_DB=./data/state.sqlite3
